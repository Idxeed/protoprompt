    "ContextDataLaneReceipt": {"construction": "result_only", "public_fields": ["lane_id", "origin", "media_type", "message_count", "input_tokens", "data_tokens", "data_bytes", "record_count"], "public_members": ["explain"]},
    "ContextPlan": {"construction": "result_only", "public_fields": ["schema_version", "trace_id", "policy_id", "system_prompt", "rag_blocks", "session_blocks", "profile_used", "decisions", "receipt", "data_lanes"], "public_members": ["render_system_prompt", "render_messages", "explain"]},
