    "MemoryScope": {"construction": "supported", "public_fields": ["tenant", "user", "thread", "kind"], "public_members": ["is_empty", "has_identity", "to_metadata", "to_where", "merge_metadata", "merge_where", "storage_doc_id", "correlation_id"]},
    "MemoryPolicy": {"construction": "safe_default_only", "public_fields": ["schema_version", "policy_id", "policy_version", "admission", "recall"], "public_members": ["safe_default", "fingerprint", "explain"]},
    "MemoryWriter": {"construction": "built_in_backends_only", "public_members": ["scope", "propose", "assert_candidate", "confirm", "quarantine", "expire", "expire_due", "supersede", "retract", "forget", "forget_by_source", "payload_readback", "purge_payloads", "erase", "get", "list_active", "events", "admission_audits", "export"]},
    "MemoryRecord": {"construction": "result_only", "public_fields": ["record_id", "scope", "kind", "state", "trust", "content", "content_hash", "source_refs", "evidence_refs", "confidence", "created_at", "updated_at", "valid_from", "valid_until", "retention_policy", "revision", "last_event_sequence", "relations", "superseded_by", "retracted_at", "expired_at", "schema_version", "origin"], "public_members": ["content_available", "is_recallable", "to_dict"]},
    "MemoryEvent": {"construction": "result_only", "public_fields": ["sequence", "event_id", "record_id", "scope", "event_type", "occurred_at", "revision", "actor", "related_record_id", "reason_code", "schema_version"], "public_members": ["to_dict"]},
    "MemoryRelation": {"construction": "supported", "public_fields": ["relation", "record_id"], "public_members": ["to_dict"]},
    "ErasureReceipt": {"construction": "result_only", "public_fields": ["record_id", "state", "payload_deleted", "source_refs_deleted", "relations_deleted", "events_deleted"], "public_members": ["to_dict"]},
    "MemoryAdmissionAudit": {"construction": "result_only", "public_fields": ["event_id", "record_id", "scope", "candidate_revision", "origin", "policy_id", "policy_version", "policy_fingerprint", "action", "reason_code", "occurred_at", "reviewer_actor", "schema_version"], "public_members": ["to_dict"]},
    "ScopePayloadReadback": {"construction": "result_only", "public_fields": ["scope_fingerprint", "payload_record_count", "schema_version"], "public_members": ["is_empty", "to_dict"]},
    "ScopePayloadPurgeReceipt": {"construction": "result_only", "public_fields": ["operation_id", "scope_fingerprint", "records_forgotten", "payload_rows_deleted", "source_refs_deleted", "relations_deleted", "readback", "schema_version"], "public_members": ["to_dict"]},
    "LedgerStorageCapabilities": {"construction": "supported", "public_fields": ["descriptor_schema_version", "contract_id", "contract_version", "backend_id", "semantic_profile", "record_schema_version", "target_storage_schema_version", "setup_mode", "backup_mode"], "public_members": ["explain"]},
    "SqliteMemoryLedger": {"construction": "supported", "public_members": ["storage_capabilities", "dry_run_setup", "setup", "schema_version", "backup", "close"]},
    "PostgresMemoryLedger": {"construction": "supported", "public_members": ["storage_capabilities", "dry_run_setup", "setup", "schema_version", "schema", "close"]}
  },
  "enum_values": {
    "LedgerBackendId": ["sqlite_v7", "postgres_v7"],
    "LedgerBackupMode": ["file_copy", "operator_managed"],
    "LedgerSetupMode": ["in_place_migration", "fresh_v7_only"],
    "MemoryEventType": ["observed", "asserted", "confirmed", "superseded", "retracted", "forgotten", "expired", "quarantined"],
    "MemoryKind": ["fact", "decision", "preference", "episode", "procedure"],
    "MemoryOrigin": ["unknown", "legacy_unknown", "user_input", "document", "tool_output", "model_extraction", "host_assertion"],
    "MemoryRelationType": ["supersedes", "derived_from", "supports", "contradicts"],
    "MemoryState": ["candidate", "active", "superseded", "retracted", "expired", "quarantined"],
